# Build stage
FROM node:20-alpine AS builder
WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build -- --configuration production

# Runtime stage
FROM nginx:alpine
COPY --from=builder /app/dist/agent-host/browser /usr/share/nginx/html

COPY nginx.conf /etc/nginx/nginx.conf

# Run nginx entirely as the unprivileged `nginx` user rather than a root master process. That
# requires a port above 1024 (8080, not 80) and writable pid/temp paths, which nginx.conf points at
# /tmp. Anything that publishes this image (docker-compose.yml, the Helm chart) must target 8080.
RUN touch /tmp/nginx.pid \
    && chown -R nginx:nginx /tmp/nginx.pid /var/cache/nginx /usr/share/nginx/html

USER nginx

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
