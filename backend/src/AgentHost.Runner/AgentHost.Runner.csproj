<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Tier d'exécution : une API minimale qui expose l'orchestration de conteneurs du nœud sur
    lequel elle tourne. Déployée en DaemonSet (un par nœud), elle est le seul processus qui a
    besoin du socket du démon.

    DÉPENDANCES VOLONTAIREMENT PAUVRES. Ce projet ne référence PAS AgentHost.Api : pas de base de
    données, pas de SignalR, pas de JWT, pas d'AWS SDK, pas de modèle métier. Un processus qui
    détient un socket équivalent à root sur le nœud doit être petit et relisible d'un bout à
    l'autre. Tout ce qu'il partage avec le backend vit dans AgentHost.Shared.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>AgentHost.Runner</RootNamespace>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentHost.Shared/AgentHost.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentHost.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le projet n'utilise que Serilog.ILogger ; le global using implicite du SDK Web rendrait
         sinon toute référence nue à `ILogger` ambiguë. -->
    <Using Remove="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
